<UserControl x:Class="LabOps.App.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:LabOps.App"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <!-- A pill: the List | Overview switch, and the overview's views -->
        <Style x:Key="Pill" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="12,3" Margin="0,0,6,0">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillRadio" TargetType="RadioButton" BasedOn="{StaticResource Pill}" />
        <Style x:Key="ViewTab" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="12,3" Margin="0,0,6,0">
                            <ContentPresenter x:Name="Text" HorizontalAlignment="Center" TextElement.Foreground="{StaticResource TextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentLightBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A link (a button) or, without a URL, plain text -->
        <DataTemplate x:Key="LinkTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                <Grid>
                    <Button Style="{StaticResource LinkButton}" Content="{Binding Label}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            HorizontalAlignment="Left"
                            Visibility="{Binding HasUrl, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Label}" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <Button Style="{StaticResource LinkButton}" Content="Remove" CommandParameter="{Binding}" Margin="12,0,0,0"
                        Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"
                        Command="{Binding DataContext.RemoveLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Stop listing this here. Nothing changes on Panorama." />
            </StackPanel>
        </DataTemplate>

        <!-- A step's tool, such as Open in Octopus. CommandParameter comes first so the command never sees it unset. -->
        <DataTemplate x:Key="ToolTemplate">
            <Button Content="{Binding Label}" CommandParameter="{Binding Parameter}" Command="{Binding Command}"
                    ToolTip="{Binding ToolTip}" ToolTipService.ShowOnDisabled="True"
                    Padding="9,2" FontSize="12" Margin="0,5,6,0" Foreground="{StaticResource AccentBrush}" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="ToolPanel">
            <WrapPanel />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="IssueTemplate">
            <Border Background="{StaticResource DangerLightBrush}" CornerRadius="3" Padding="8,4" Margin="0,0,0,4">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
            </Border>
        </DataTemplate>

        <!-- One step: its mark, label, status, assignee and note, the buttons that apply, then its links and tools -->
        <DataTemplate x:Key="StageTemplate">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Width="26" FontSize="15" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#x25CB;" />
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="done">
                                            <Setter Property="Text" Value="&#x2713;" />
                                            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="in_progress">
                                            <Setter Property="Text" Value="&#x25CF;" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="skipped">
                                            <Setter Property="Text" Value="&#x2013;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="330" HorizontalAlignment="Right">
                            <Button Content="Start" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.StartStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Done" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.FinishStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding CanFinish, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Skip" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.SkipStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding CanSkip, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Reopen" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.ReopenStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding CanReopen, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Assign" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.AssignCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding CanAssign, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Choose who does this step." />
                            <Button Content="Plan" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.PlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding CanPlan, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="When this step should start and be finished. The overview shows the plan, and the step as late once it has passed." />
                            <Button Content="Remove" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Remove a step added by mistake. A step that does not apply is skipped instead." />
                        </WrapPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding AssignedText}" Style="{StaticResource Muted}"
                                       Visibility="{Binding AssignedText, Converter={StaticResource NullToVisibility}}" />
                            <TextBlock Text="{Binding PlannedText}" Visibility="{Binding PlannedText, Converter={StaticResource NullToVisibility}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLate}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontStyle="Italic" TextWrapping="Wrap"
                                       Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                    <!-- What was recorded for the step, and its tools, across the full width under it -->
                    <ItemsControl ItemsSource="{Binding Links}" ItemTemplate="{StaticResource LinkTemplate}" Margin="26,4,0,0"
                                  Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource ToolTemplate}" ItemsPanel="{StaticResource ToolPanel}"
                                  Margin="26,0,0,0" Visibility="{Binding HasTools, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Problems with the repository as a whole -->
        <Border DockPanel.Dock="Top" Background="{StaticResource WarnLightBrush}" BorderBrush="#F79009" BorderThickness="0,0,0,1"
                Padding="12,8" Visibility="{Binding Banner, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" />
        </Border>

        <!-- The list of projects, or the overview of everyone's work -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,0">
            <RadioButton Content="List" GroupName="ProjectsMode" Style="{StaticResource PillRadio}" IsChecked="{Binding ShowList}"
                         ToolTip="Every project, to search and open one." />
            <RadioButton Content="Overview" GroupName="ProjectsMode" Style="{StaticResource PillRadio}" IsChecked="{Binding ShowOverview}"
                         ToolTip="What needs attention, the board, the timeline, the calendar and the instruments, for everyone or one person." />
        </StackPanel>

        <Grid>
        <Grid Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="680" MinWidth="340" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Project list -->
            <DockPanel Grid.Column="0" Margin="10,10,4,10">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <CheckBox DockPanel.Dock="Right" Content="{Binding ShowClosedText}" IsChecked="{Binding ShowClosed}" VerticalAlignment="Center" Margin="8,0,0,0"
                              ToolTip="Closed projects are read only while this is ticked, which keeps the list quick." />
                    <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by project, experiment, lab, PI, institution, species, instrument, funding, step, or person" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,6,0,0"
                           Text="Click a column heading to sort by it." />
                <ListView ItemsSource="{Binding Projects}" SelectedItem="{Binding Selected}" BorderBrush="{StaticResource BorderBrush}"
                          app:GridViewSort.Enabled="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Project" Width="150" DisplayMemberBinding="{Binding Name}" app:GridViewSort.Property="Name" />
                            <GridViewColumn Header="Lab" Width="125" DisplayMemberBinding="{Binding LabName}" app:GridViewSort.Property="LabName" />
                            <GridViewColumn Header="Progress" Width="190" DisplayMemberBinding="{Binding Progress}" app:GridViewSort.Property="ProgressRank" />
                            <GridViewColumn Header="Assigned" Width="110" DisplayMemberBinding="{Binding Assigned}" app:GridViewSort.Property="Assigned" />
                            <GridViewColumn Header="Modified" Width="80" DisplayMemberBinding="{Binding ModifiedText}" app:GridViewSort.Property="Modified" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <!-- Selected project -->
            <Grid Grid.Column="2" Margin="10">
                <TextBlock Style="{StaticResource Muted}" Margin="4,8" FontSize="14" TextWrapping="Wrap"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}"
                           Text="Select a project to see its samples and experiments, or start a new one with New project." />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{Binding SelectedHeadline}" Style="{StaticResource Heading}" />
                        <TextBlock Text="{Binding SelectedTitle}" FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding SelectedDetail}" Style="{StaticResource Muted}" Margin="0,4,0,8" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding SelectedIssues}" ItemTemplate="{StaticResource IssueTemplate}" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Content="Ask Claude to update it" Command="{Binding AskClaudeCommand}" Style="{StaticResource PrimaryButton}"
                                    ToolTip="Record progress, add a notebook, Panorama folder or analysis repository, or change anything else, by telling Claude." />
                            <Button Content="New experiment" Command="{Binding NewExperimentCommand}"
                                    ToolTip="Another measurement of these samples, for example PRM on the Stellar after DIA on the Astral. Claude asks what it is." />
                            <Button Content="Wiki page" Command="{Binding ViewWikiCommand}"
                                    ToolTip="The project's page on Panorama, with every step and where the data are. The app keeps it up to date; the collaborators who can open the folder can read it." />
                            <Button Content="Folder" Command="{Binding OpenFolderCommand}" />
                            <Button Content="On GitHub" Command="{Binding OpenOnGitHubCommand}" />
                        </WrapPanel>

                        <StackPanel Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                            <TextBlock Text="Links" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Links}" ItemTemplate="{StaticResource LinkTemplate}" />
                        </StackPanel>

                        <!-- The samples' timeline, then one per experiment -->
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,16,0,0">
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,4">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Add a step" CommandParameter="{Binding}" Margin="0"
                                                        Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="For work this timeline does not show yet: a second shipment, unblinded metadata, assay development, another analysis." />
                                                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource ToolTemplate}"
                                                              ItemsPanel="{StaticResource ToolPanel}" VerticalAlignment="Center" Margin="8,-5,4,0" />
                                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                        <ItemsControl ItemsSource="{Binding Issues}" ItemTemplate="{StaticResource IssueTemplate}" Margin="0,4,0,0" />
                                        <ItemsControl ItemsSource="{Binding Links}" ItemTemplate="{StaticResource LinkTemplate}" Margin="0,4,0,0"
                                                      Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibility}}" />
                                        <ItemsControl ItemsSource="{Binding Stages}" ItemTemplate="{StaticResource StageTemplate}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- The overview: a page drawn from the loaded projects, with no scripts -->
        <DockPanel DataContext="{Binding Overview}" Margin="10"
                   Visibility="{Binding DataContext.ShowOverview, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <ListBox ItemsSource="{Binding Tabs}" SelectedValue="{Binding View}" SelectedValuePath="View" DisplayMemberPath="Label"
                         ItemContainerStyle="{StaticResource ViewTab}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                         AutomationProperties.Name="Overview view">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock Text="Whose" VerticalAlignment="Center" Margin="12,0,6,0" Style="{StaticResource Muted}" />
                <ComboBox ItemsSource="{Binding People}" SelectedItem="{Binding Person}" DisplayMemberPath="Label" Width="170"
                          AutomationProperties.Name="Whose work" ToolTip="Work assigned to them, or on projects they are the lab contact for." />
                <TextBlock Text="Lab" VerticalAlignment="Center" Margin="12,0,6,0" Style="{StaticResource Muted}" />
                <ComboBox ItemsSource="{Binding Labs}" SelectedItem="{Binding Lab}" DisplayMemberPath="Label" Width="170"
                          AutomationProperties.Name="Lab" />
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Visibility="{Binding IsCalendar, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="&#x2039;" Command="{Binding PreviousMonthCommand}" Padding="8,2" AutomationProperties.Name="Previous month" />
                    <TextBlock Text="{Binding MonthText}" VerticalAlignment="Center" Margin="4,0" MinWidth="110" TextAlignment="Center" />
                    <Button Content="&#x203A;" Command="{Binding NextMonthCommand}" Padding="8,2" AutomationProperties.Name="Next month" />
                    <Button Content="This month" Command="{Binding ThisMonthCommand}" Margin="6,0,0,0" />
                </StackPanel>
            </WrapPanel>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <wv2:WebView2 x:Name="OverviewPage" DefaultBackgroundColor="White" />
                    <TextBlock x:Name="NoOverview" Visibility="Collapsed" Margin="12" TextWrapping="Wrap" Style="{StaticResource Muted}"
                               Text="The overview cannot be shown because its browser component (WebView2) could not start. The list of projects still works." />
                </Grid>
            </Border>
        </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
