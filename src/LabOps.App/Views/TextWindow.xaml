<Window x:Class="LabOps.App.Views.TextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="640" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" Style="{StaticResource Heading}" FontSize="15" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,4,0,8"
                   Text="Lines starting with - were taken out; lines starting with + were added." />
        <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,10,0,0" />
        <TextBox x:Name="Body" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
