<Window x:Class="LabOps.App.Views.ChooseProtocolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="560" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" Style="{StaticResource Heading}" FontSize="15" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,8,0,10" Style="{StaticResource Muted}"
                   Text="Choose the protocol this step followed and the version that was used. Only published versions can be recorded, so the record always opens exactly what was done." />
        <TextBox x:Name="Search" DockPanel.Dock="Top" Margin="0,0,0,6" TextChanged="OnSearch"
                 ToolTip="Search by title, ID, category, tag, sample type or instrument" />
        <StackPanel DockPanel.Dock="Bottom">
            <DockPanel Margin="0,10,0,0">
                <TextBlock Text="Version" Width="70" VerticalAlignment="Center" />
                <ComboBox x:Name="VersionBox" DisplayMemberPath="Label" />
            </DockPanel>
            <TextBlock x:Name="Note" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="70,4,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" IsCancel="True" />
                <Button x:Name="OkButton" Content="Record it" IsDefault="True" Click="OnOk" Style="{StaticResource PrimaryButton}" Margin="0" />
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="Choices" SelectionChanged="OnSelected" BorderBrush="{StaticResource BorderBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
