<UserControl x:Class="LabOps.App.Views.ProtocolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:LabOps.App"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <DataTemplate x:Key="IssueTemplate">
            <Border Background="{StaticResource DangerLightBrush}" CornerRadius="3" Padding="8,4" Margin="0,0,0,4">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Before the protocols are downloaded -->
        <StackPanel Margin="24" MaxWidth="600" HorizontalAlignment="Left"
                    Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="The lab protocols" Style="{StaticResource Heading}" />
            <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,6,0,0"
                       Text="The lab's protocols are not on this computer yet. Download them in Setup to read any version, write new ones with Claude, and record which version a project's sample prep followed." />
            <Button Content="Open Setup" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                    Command="{Binding DataContext.OpenSetupCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>

        <DockPanel Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
            <!-- Problems with the repository as a whole -->
            <Border DockPanel.Dock="Top" Background="{StaticResource WarnLightBrush}" BorderBrush="#F79009" BorderThickness="0,0,0,1"
                    Padding="12,8" Visibility="{Binding Banner, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="600" MinWidth="340" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                </Grid.ColumnDefinitions>

                <!-- Protocol list -->
                <DockPanel Grid.Column="0" Margin="10,10,4,10">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <CheckBox DockPanel.Dock="Right" Content="Show retired" IsChecked="{Binding ShowRetired}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <ComboBox DockPanel.Dock="Right" Width="150" Margin="6,0,0,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" />
                        <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by title, ID, short name, tag, sample type, instrument or owner" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,6,0,0"
                               Text="Click a column heading to sort by it." />
                    <ListView ItemsSource="{Binding Protocols}" SelectedItem="{Binding Selected}" BorderBrush="{StaticResource BorderBrush}"
                              app:GridViewSort.Enabled="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Protocol" Width="230" DisplayMemberBinding="{Binding Title}" app:GridViewSort.Property="Title" />
                                <GridViewColumn Header="Category" Width="120" DisplayMemberBinding="{Binding Category}" app:GridViewSort.Property="Category" />
                                <GridViewColumn Header="Version" Width="75" DisplayMemberBinding="{Binding Version}" app:GridViewSort.Property="VersionRank" />
                                <GridViewColumn Header="Published" Width="80" DisplayMemberBinding="{Binding Published}" app:GridViewSort.Property="Published" />
                                <GridViewColumn Header="Owner" Width="110" DisplayMemberBinding="{Binding OwnerName}" app:GridViewSort.Property="OwnerName" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

                <!-- Selected protocol -->
                <DockPanel Grid.Column="2" Margin="10">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="4,8" FontSize="14" TextWrapping="Wrap"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}"
                               Text="Select a protocol to read it, or add one with New protocol." />
                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource Heading}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedDetail}" Style="{StaticResource Muted}" Margin="0,4,0,8" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding SelectedIssues}" ItemTemplate="{StaticResource IssueTemplate}" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Content="Ask Claude to change it" Command="{Binding AskClaudeCommand}" Style="{StaticResource PrimaryButton}"
                                    ToolTip="Tell Claude what to change. The change goes in the draft; the published versions stay as they are." />
                            <Button Content="{Binding PublishText}" Command="{Binding PublishCommand}"
                                    ToolTip="Make the draft the next version, the one to use at the bench. Look at Show changes first. Needs a draft with changes and no errors."
                                    ToolTipService.ShowOnDisabled="True" />
                            <Button Content="Show changes" Command="{Binding ShowChangesCommand}"
                                    ToolTip="What changed: the draft since the current version, or a version since the one before." ToolTipService.ShowOnDisabled="True" />
                            <Button Content="Update from a file" Command="{Binding UpdateFromFileCommand}"
                                    ToolTip="Choose a newer original (a Word document, a PDF), and Claude brings the draft up to date with it." />
                            <Button Content="Print" Command="{Binding PrintCommand}"
                                    ToolTip="Open the page shown in your browser, to print it or save it as a PDF." ToolTipService.ShowOnDisabled="True" />
                            <Button Content="Retire" Command="{Binding RetireCommand}"
                                    Visibility="{Binding IsRetiredSelected, Converter={StaticResource InverseBoolToVisibility}}"
                                    ToolTip="Mark it as no longer used, and name the protocol that replaces it. Every version stays." ToolTipService.ShowOnDisabled="True" />
                            <Button Content="Make active" Command="{Binding ReactivateCommand}"
                                    Visibility="{Binding IsRetiredSelected, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Folder" Command="{Binding OpenFolderCommand}" />
                            <Button Content="On GitHub" Command="{Binding OpenOnGitHubCommand}" />
                        </WrapPanel>
                        <DockPanel Margin="0,4,0,8">
                            <TextBlock Text="Showing" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                                      ToolTip="Any version ever published, or the draft. The page says which one it is." />
                        </DockPanel>
                    </StackPanel>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <wv2:WebView2 x:Name="Preview" DefaultBackgroundColor="White" />
                            <TextBlock x:Name="NoPreview" Visibility="Collapsed" Margin="12" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="The page cannot be shown here because the WebView2 runtime is missing. Use Print to open it in your browser." />
                        </Grid>
                    </Border>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
