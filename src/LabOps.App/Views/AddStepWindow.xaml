<Window x:Class="LabOps.App.Views.AddStepWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" Style="{StaticResource Heading}" FontSize="15" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,12" Style="{StaticResource Muted}"
                   Text="For work the timeline does not show yet: a second shipment of samples, unblinded metadata, assay development, a second analysis. Give it a label when the kind alone does not say what it is." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Kind" VerticalAlignment="Center" />
            <ComboBox x:Name="Kind" Grid.Row="0" Grid.Column="1" DisplayMemberPath="Label" Margin="0,2,0,6" />
            <TextBlock Grid.Row="1" Text="Label" VerticalAlignment="Center" />
            <TextBox x:Name="Label" Grid.Row="1" Grid.Column="1" Margin="0,2,0,6"
                     ToolTip="Optional unless the kind is Other. For example: Unblinded metadata from MNRF; Second shipment" />
            <TextBlock Grid.Row="2" Text="Put it" VerticalAlignment="Center" />
            <ComboBox x:Name="Position" Grid.Row="2" Grid.Column="1" DisplayMemberPath="Label" Margin="0,2,0,6" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Add step" IsDefault="True" Click="OnOk" Style="{StaticResource PrimaryButton}" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
