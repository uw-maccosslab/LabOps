<Window x:Class="LabOps.App.Views.AssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" Style="{StaticResource Heading}" FontSize="15" TextWrapping="Wrap" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,8,0,12" Style="{StaticResource Muted}" />
        <DockPanel>
            <TextBlock Text="Who" Width="60" VerticalAlignment="Center" />
            <ComboBox x:Name="Who" DisplayMemberPath="Label" />
        </DockPanel>
        <CheckBox x:Name="Later" Margin="60,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Assign" IsDefault="True" Click="OnOk" Style="{StaticResource PrimaryButton}" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
