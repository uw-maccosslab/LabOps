<Window x:Class="LabOps.App.Views.NewProtocolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="New protocol" Style="{StaticResource Heading}" FontSize="15" />
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,12" Style="{StaticResource Muted}"
                   Text="Claude writes it in the lab's format: from a file you choose (Word, PDF, LaTeX, Markdown or text), or by asking you for the steps. It stays a draft for you to review until someone publishes version 1." />
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Title" Width="80" VerticalAlignment="Center" />
            <TextBox x:Name="TitleBox" ToolTip="The full name, for example S-Trap micro digestion" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Category" Width="80" VerticalAlignment="Center" />
            <ComboBox x:Name="CategoryBox" DisplayMemberPath="Label" />
        </DockPanel>
        <DockPanel>
            <TextBlock Text="From files" Width="80" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Clear" Click="OnClear" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Choose..." Click="OnChoose" Margin="6,0,0,0" />
            <TextBox x:Name="FileBox" IsReadOnly="True" Background="{StaticResource SurfaceBrush}"
                     ToolTip="Optional. Choose every file at once: the protocol's documents (Word, PDF, LaTeX, Markdown or text) and any method files its steps run (a KingFisher or other robot program, an instrument method). Without files, Claude asks you for the protocol's steps." />
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Start with Claude" IsDefault="True" Click="OnOk" Style="{StaticResource PrimaryButton}" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
