<Window x:Class="LabOps.App.Views.WikiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding Heading}" Width="1120" Height="820" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" Style="{StaticResource Heading}" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,8">
            <TextBlock Text="{Binding Where}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <Button Style="{StaticResource LinkButton}" Content="Open on Panorama" Click="OnOpenOnPanorama" Margin="12,0,0,0"
                    ToolTip="The page as it is on Panorama now" />
        </StackPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="10,7" Margin="0,0,0,10">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Write the text with Claude" Click="OnWriteText" IsEnabled="{Binding IsIdle}"
                        ToolTip="Claude writes or rewrites the summary, plan and description of the samples (the project's wiki.yaml). You see the page again before it is published." />
                <Button Content="Publish" Click="OnPublish" Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding CanPublish}"
                        ToolTip="Put this page on Panorama. Everyone who can open the folder can read it, the collaborators included." />
                <Button Content="Close" IsCancel="True" Margin="0" />
            </StackPanel>
            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"
                       Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}" />
        </DockPanel>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White">
            <Grid>
                <wv2:WebView2 x:Name="Preview" DefaultBackgroundColor="White" />
                <TextBlock x:Name="NoPreview" Visibility="Collapsed" Margin="16" TextWrapping="Wrap" Style="{StaticResource Muted}"
                           Text="The preview needs the WebView2 runtime, which is not installed. Publish still works, and Open on Panorama shows the result." />
            </Grid>
        </Border>
    </DockPanel>
</Window>
