<UserControl x:Class="LabOps.App.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LabOps.App.ViewModels"
             Background="{StaticResource SurfaceBrush}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:UserMessageItem}">
            <Border Background="{StaticResource AccentLightBrush}" CornerRadius="6" Padding="10,6" Margin="40,4,0,4" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AssistantMessageItem}">
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,4,30,4">
                <TextBox Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" />
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityItem}">
            <TextBlock Text="{Binding Text}" FontSize="12" Margin="6,1" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                <Setter Property="TextDecorations" Value="Strikethrough" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NoticeItem}">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="6,4" FontStyle="Italic">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SignInItem}">
            <Border Background="{StaticResource WarnLightBrush}" BorderBrush="#F79009" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,6">
                <StackPanel>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"
                               Text="A console window opens and your browser opens Claude. If the page says the window is too small, make it larger, then choose Authorize and close the console window." />
                    <WrapPanel>
                        <Button Content="Sign in to Claude" Command="{Binding SignInCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="Try again" Command="{Binding TryAgainCommand}"
                                ToolTip="Start this conversation again with the new sign-in." ToolTipService.ShowOnDisabled="True" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuestionItem}">
            <Border Background="{StaticResource WarnLightBrush}" BorderBrush="#F79009" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,6">
                <StackPanel>
                    <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Options}" Visibility="{Binding IsAnswered, Converter={StaticResource InverseBoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.AnswerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Visibility="{Binding IsAnswered, Converter={StaticResource InverseBoolToVisibility}}">
                        <Button x:Name="AnswerButton" DockPanel.Dock="Right" Content="Answer" Command="{Binding AnswerCommand}" CommandParameter="" Margin="6,0,0,0" />
                        <TextBox x:Name="QuestionBox" Text="{Binding Typed, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Given, StringFormat=You answered: {0}}" Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding IsAnswered, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportItem}">
            <Border Background="White" BorderBrush="{StaticResource OkBrush}" BorderThickness="2" CornerRadius="6" Padding="12,10" Margin="0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource OkBrush}" />
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat=- {0}}" TextWrapping="Wrap" Margin="8,1,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseCommand}" Margin="0" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                    <Button Content="Send" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,4" IsDefault="True" />
                    <Button Content="Stop" Command="{Binding StopCommand}" Margin="0" />
                </StackPanel>
                <TextBox x:Name="ChatInput" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="160"
                         VerticalScrollBarVisibility="Auto" ToolTip="Ask Claude for a change, or answer its question" />
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="Claude is working..." Margin="10,4" FontStyle="Italic" Foreground="{StaticResource MutedBrush}"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="10">
            <ItemsControl x:Name="Transcript" ItemsSource="{Binding Items}" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
