<Window x:Class="LabOps.App.Views.PlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" Style="{StaticResource Heading}" FontSize="15" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,12" Style="{StaticResource Muted}"
                   Text="When this step should start and be finished. Either date can be left empty. The overview shows the plan, and the step as late once a date has passed and it is not done." />
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Start" Width="60" VerticalAlignment="Center" />
            <DatePicker x:Name="Start" SelectedDateFormat="Short" AutomationProperties.Name="Planned start" />
        </DockPanel>
        <DockPanel>
            <TextBlock Text="Finish" Width="60" VerticalAlignment="Center" />
            <DatePicker x:Name="Finish" SelectedDateFormat="Short" AutomationProperties.Name="Planned finish" />
        </DockPanel>
        <TextBlock x:Name="Problem" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="60,8,0,0" Visibility="Collapsed" />
        <DockPanel Margin="0,16,0,0">
            <Button x:Name="ClearButton" DockPanel.Dock="Left" Content="Remove the plan" Click="OnClear" Margin="0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" />
                <Button Content="Save" IsDefault="True" Click="OnOk" Style="{StaticResource PrimaryButton}" Margin="0" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
