<Window x:Class="LabOps.App.Views.SamplesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1000" Height="640" MinWidth="520" MinHeight="300" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource Heading}" Margin="0,0,0,8" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <ComboBox DockPanel.Dock="Left" Width="300" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                      ToolTip="The organized sample table, or a file the collaborator sent, as converted to CSV without identifying information." />
            <Button DockPanel.Dock="Right" Content="Show in folder" Click="OnShowInFolder" Margin="8,0,0,0" />
            <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" VerticalContentAlignment="Center"
                     ToolTip="Show only rows containing every word typed, in any column" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Style="{StaticResource Muted}"
                   Text="Read only. Click a column heading to sort by it; select cells and press Ctrl+C to copy them with their headings." />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Margin="0,8,0,0" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"
                   Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
        <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" CanUserSortColumns="True"
                  SelectionUnit="CellOrRowHeader" SelectionMode="Extended" ClipboardCopyMode="IncludeHeader"
                  FrozenColumnCount="1" HeadersVisibility="All" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource BorderBrush}" BorderBrush="{StaticResource BorderBrush}"
                  Background="White" RowHeaderWidth="12" AlternatingRowBackground="#F7F9FB"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.ColumnHeaderStyle>
                <!-- Plain text, so an underscore (Sample_ID) is shown rather than read as an access key. -->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Padding" Value="6,3" />
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>
        </DataGrid>
    </DockPanel>
</Window>
