<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LabOps.App</RootNamespace>
    <AssemblyName>LabOps</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!--
      Velopack requires VelopackApp.Build().Run() to be the first thing that executes, so the app
      supplies its own Program.Main and App.xaml is demoted from ApplicationDefinition to Page
      (below), as in PanoramaBridge. DISABLE_XAML_GENERATED_MAIN alone is not enough: the WPF
      markup-compile project does not inherit DefineConstants.
    -->
    <StartupObject>LabOps.App.Program</StartupObject>

    <!-- Velopack packs a folder publish; single-file would defeat delta updates. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <!--
      UseWPF drops System.IO from the implicit usings because its Path collides with
      System.Windows.Shapes.Path. This app draws no shapes, and works with files everywhere.
    -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabOps.Core\LabOps.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Tools shipped inside the app. release.yml downloads pinned uv and gh builds into tools\
      before packing; a development build finds them on the PATH instead (see ToolLocator).
    -->
    <None Include="tools\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The labops tool, which Claude's skills and the pre-commit hook run, is in tools\ too, so Claude
    sessions find it first on their PATH. release.yml publishes it compiled ahead of time into
    tools\; a development build builds the tool and copies its build there (below).
    It is deliberately not a ProjectReference, not even with ReferenceOutputAssembly="false": the
    SDK copies a referenced program's labops.deps.json and runtimeconfig into this folder, where
    Windows, ignoring case, takes it for LabOps.deps.json. Whichever was written last won; when it
    was labops's, the app could not find its own libraries and did not start (26.10.0, 26.11.0).
  -->
  <Target Name="CopyLabopsTool" AfterTargets="Build" Condition="!Exists('tools\labops.exe')">
    <MSBuild Projects="..\LabOps.Cli\LabOps.Cli.csproj" Targets="Build" Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishReadyToRun;OutDir;OutputPath" />
    <ItemGroup>
      <LabopsToolFile Include="..\LabOps.Cli\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(LabopsToolFile)" DestinationFolder="$(OutDir)tools\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="LabOps.Tests" />
  </ItemGroup>

</Project>
