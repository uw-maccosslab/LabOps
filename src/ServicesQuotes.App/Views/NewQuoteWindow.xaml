<Window x:Class="ServicesQuotes.App.Views.NewQuoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ServicesQuotes.App.ViewModels"
        Title="New quote" Width="820" Height="760" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="New quote" Style="{StaticResource Heading}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="Paste the request email, or give a Gmail search that finds it, and fill in anything you already know. Claude drafts the quote and asks about anything missing." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Draft with Claude" IsDefault="True" Click="OnStart" Style="{StaticResource PrimaryButton}" Margin="0" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Setter Property="Margin" Value="0,6,8,0" />
                    </Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Margin" Value="0,2,0,6" />
                    </Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Margin" Value="0,2,0,6" />
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Text="Request email (pasted)" />
                <TextBox x:Name="EmailBox" Grid.Row="0" Grid.Column="1" Text="{Binding EmailText}" AcceptsReturn="True" TextWrapping="Wrap" Height="170" VerticalScrollBarVisibility="Auto" />
                <TextBlock Grid.Row="1" Text="Or a Gmail search" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GmailSearch}" ToolTip="For example: from:ella.cole@clearwaterzoo.example marten" />
                <TextBlock Grid.Row="2" Text="Requester (name, degree)" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Requester}" />
                <TextBlock Grid.Row="3" Text="Institution" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Institution}" />
                <TextBlock Grid.Row="4" Text="PI (if different)" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Pi}" />
                <TextBlock Grid.Row="5" Text="cc" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Cc}" />
                <TextBlock Grid.Row="6" Text="Study samples" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Samples}" />
                <TextBlock Grid.Row="7" Text="Sample type" />
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SampleType}" ToolTip="Plasma, CSF, tissue, cells, ..." />
                <TextBlock Grid.Row="8" Text="Species" />
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Species}" />
                <TextBlock Grid.Row="9" Text="Service" />
                <ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{x:Static vm:NewQuoteViewModel.Services}" SelectedItem="{Binding Service}" />
                <TextBlock Grid.Row="10" Text="Human samples" />
                <ComboBox Grid.Row="10" Grid.Column="1" ItemsSource="{x:Static vm:NewQuoteViewModel.HumanChoices}" SelectedItem="{Binding Human}" />
                <TextBlock Grid.Row="11" Text="Timing" />
                <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Timing}" />
                <TextBlock Grid.Row="12" Text="Notes for Claude" />
                <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
