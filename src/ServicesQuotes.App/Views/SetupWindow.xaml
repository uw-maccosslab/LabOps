<Window x:Class="ServicesQuotes.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up Services Quotes" Width="760" Height="640" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Set up Services Quotes" Style="{StaticResource Heading}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="The app needs a few tools and sign-ins. Each button does one step; sign-ins open your browser. You only do this once." />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Done" IsDefault="True" Click="OnDone" Style="{StaticResource PrimaryButton}" Margin="0" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Width="28" FontSize="16" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="o" />
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Done}" Value="True">
                                                    <Setter Property="Text" Value="&#x2713;" />
                                                    <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding AlternateLabel}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.AlternateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Visibility="{Binding HasAlternate, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{Binding FixLabel}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
