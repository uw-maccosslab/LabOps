<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LabOps.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ASP.NET Core hosts the small MCP server that gives Claude its app tools (ask_user,
      report_quote_summary, and the permission prompt). It listens on 127.0.0.1 only. An HTTP
      server inside the process was chosen over a stdio server because a stdio server would be a
      separate process that Claude starts, which would then need its own channel back to this
      app's windows; in-process, a tool call can show a dialog directly.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LabOps.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabOps.Engines\LabOps.Engines.csproj" />
  </ItemGroup>

</Project>
