<Window x:Class="ChargeState.App.Views.AddLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" Style="{StaticResource Heading}" FontSize="15" TextWrapping="Wrap" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,8,0,12" Style="{StaticResource Muted}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="What" VerticalAlignment="Center" />
            <ComboBox x:Name="What" Grid.Row="0" Grid.Column="1" DisplayMemberPath="Label" Margin="0,2,0,6" SelectionChanged="OnWhatChanged" />
            <TextBlock x:Name="AddressLabel" Grid.Row="1" Text="Address" VerticalAlignment="Center" />
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,2,0,2">
                <Button x:Name="Browse" DockPanel.Dock="Right" Content="Browse..." Margin="6,0,0,0" Click="OnBrowse"
                        ToolTip="Choose the folder on Panorama, signed in the way PanoramaBridge is" />
                <TextBox x:Name="Address" />
            </DockPanel>
            <Button x:Name="FindIt" Grid.Row="2" Grid.Column="1" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                    Margin="0,0,0,6" Click="OnFindIt" />
            <TextBlock x:Name="IdLabel" Grid.Row="3" Text="Notebook ID" VerticalAlignment="Center" />
            <TextBox x:Name="NotebookId" Grid.Row="3" Grid.Column="1" Margin="0,2,0,6"
                     ToolTip="For example ELN-4485-20230314-179, shown at the top of the notebook" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Add link" IsDefault="True" Click="OnOk" Style="{StaticResource PrimaryButton}" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
