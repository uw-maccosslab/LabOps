<Window x:Class="ChargeState.App.Views.PermissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude is asking permission" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
    <StackPanel Margin="20">
        <TextBlock Text="Claude wants to do something that is not on its usual list:" Style="{StaticResource Muted}" />
        <TextBlock x:Name="Description" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,8" />
        <Expander Header="Details">
            <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Margin="0,6,0,0" />
        </Expander>
        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                   Text="If you are not sure what this does, choose Don't allow. Claude will continue without it or explain what it needed." />
        <CheckBox x:Name="Remember" Margin="0,10,0,0">
            <TextBlock x:Name="RememberText" TextWrapping="Wrap" />
        </CheckBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Don't allow" IsCancel="True" IsDefault="True" Click="OnDeny" />
            <Button Content="Allow" Click="OnAllow" Style="{StaticResource PrimaryButton}" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
