<Window x:Class="ChargeState.App.Views.StageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" Style="{StaticResource Heading}" FontSize="15" TextWrapping="Wrap" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,8,0,10" Style="{StaticResource Muted}" />
        <StackPanel x:Name="DateRow" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Date" Width="60" VerticalAlignment="Center" />
            <DatePicker x:Name="When" Width="160" SelectedDateFormat="Short" />
        </StackPanel>
        <DockPanel>
            <TextBlock Text="Note" Width="60" VerticalAlignment="Top" Margin="0,4,0,0" />
            <TextBox x:Name="Note" AcceptsReturn="False" TextWrapping="Wrap" MinHeight="50"
                     ToolTip="Optional. For example: 92 tubes on dry ice, 2 hemolyzed; plates 1 and 2" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="OnOk" Style="{StaticResource PrimaryButton}" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
