<Window x:Class="ChargeState.App.Views.PanoramaSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to Panorama" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Sign in to Panorama" Style="{StaticResource Heading}" FontSize="15" />
        <TextBlock x:Name="Message" Style="{StaticResource Muted}" Margin="0,8,0,12" />
        <RadioButton x:Name="UseApiKey" Content="API key (recommended)" IsChecked="True" Checked="OnModeChanged" Margin="0,0,0,4" />
        <StackPanel x:Name="ApiKeyFields" Margin="22,2,0,8">
            <PasswordBox x:Name="ApiKey" Padding="4,3" />
            <Button Style="{StaticResource LinkButton}" Content="Create an API key on Panorama" HorizontalAlignment="Left" Margin="0,4,0,0"
                    Click="OnCreateApiKey" />
        </StackPanel>
        <RadioButton x:Name="UseLogin" Content="Panorama user name and password" Checked="OnModeChanged" Margin="0,4,0,4" />
        <Grid x:Name="LoginFields" Margin="22,2,0,8" IsEnabled="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="User name" VerticalAlignment="Center" />
            <TextBox x:Name="UserName" Grid.Column="1" Margin="0,2" />
            <TextBlock Grid.Row="1" Text="Password" VerticalAlignment="Center" />
            <PasswordBox x:Name="Password" Grid.Row="1" Grid.Column="1" Margin="0,2" Padding="4,3" />
        </Grid>
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12"
                   Text="ChargeState keeps it in Windows Credential Manager on this computer, separate from PanoramaBridge's, and only reads from Panorama." />
        <TextBlock x:Name="Problem" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button x:Name="SignIn" Content="Sign in" IsDefault="True" Click="OnSignIn" Style="{StaticResource PrimaryButton}" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
